# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Note: If no DB is provided, system will smoothly use high-speed in-memory repository
DATABASE_URL=mongodb://127.0.0.1:27017/ai_kids_tutor

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://ai-kids-english-tutor.vercel.app

# AI / LLM Configuration (Google Gemini 2.0 / 1.5 Flash recommended for <2s latency)
# If no key is set, the system automatically uses a high-fidelity local child intelligence engine
GEMINI_API_KEY=
OPENAI_API_KEY=

# Logging Configuration
LOG_LEVEL=info
